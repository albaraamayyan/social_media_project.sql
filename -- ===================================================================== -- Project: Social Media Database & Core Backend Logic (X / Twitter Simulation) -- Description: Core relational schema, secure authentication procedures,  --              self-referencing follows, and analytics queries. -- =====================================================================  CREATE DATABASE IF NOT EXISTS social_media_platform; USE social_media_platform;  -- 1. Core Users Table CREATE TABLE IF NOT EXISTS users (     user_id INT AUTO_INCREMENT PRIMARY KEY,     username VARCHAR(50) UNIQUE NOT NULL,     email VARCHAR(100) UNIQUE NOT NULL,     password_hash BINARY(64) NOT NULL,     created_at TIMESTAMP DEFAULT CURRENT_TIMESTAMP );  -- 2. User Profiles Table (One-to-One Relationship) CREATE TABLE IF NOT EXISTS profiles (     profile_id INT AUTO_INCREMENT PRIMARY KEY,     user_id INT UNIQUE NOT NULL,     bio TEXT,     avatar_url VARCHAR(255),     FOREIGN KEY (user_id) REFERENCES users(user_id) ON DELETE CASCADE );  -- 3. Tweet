-- =====================================================================
-- Project: Social Media Database & Core Backend Logic (X / Twitter Simulation)
-- Description: Core relational schema, secure authentication procedures, 
--              self-referencing follows, and analytics queries.
-- =====================================================================

CREATE DATABASE IF NOT EXISTS social_media_platform;
USE social_media_platform;

-- 1. Core Users Table
CREATE TABLE IF NOT EXISTS users (
    user_id INT AUTO_INCREMENT PRIMARY KEY,
    username VARCHAR(50) UNIQUE NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    password_hash BINARY(64) NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 2. User Profiles Table (One-to-One Relationship)
CREATE TABLE IF NOT EXISTS profiles (
    profile_id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT UNIQUE NOT NULL,
    bio TEXT,
    avatar_url VARCHAR(255),
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE
);

-- 3. Tweets Table (One-to-Many Relationship)
CREATE TABLE IF NOT EXISTS tweets (
    tweet_id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT NOT NULL,
    tweet_content TEXT NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE
);

-- 4. Follows Table (Many-to-Many Self-Referencing Relationship)
CREATE TABLE IF NOT EXISTS follows (
    follower_id INT,
    following_id INT,
    PRIMARY KEY (follower_id, following_id),
    FOREIGN KEY (follower_id) REFERENCES users(user_id) ON DELETE CASCADE,
    FOREIGN KEY (following_id) REFERENCES users(user_id) ON DELETE CASCADE
);

-- 5. Likes Table (Many-to-Many Relationship)
CREATE TABLE IF NOT EXISTS likes (
    user_id INT,
    tweet_id INT,
    liked_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (user_id, tweet_id),
    FOREIGN KEY (user_id) REFERENCES users(user_id) ON DELETE CASCADE,
    FOREIGN KEY (tweet_id) REFERENCES tweets(tweet_id) ON DELETE CASCADE
);

-- =====================================================================
-- Stored Procedure: createAccount
-- Handles user registration, security hashing, and profile creation
-- =====================================================================
DELIMITER //

CREATE PROCEDURE createAccount(
    IN p_username VARCHAR(50),
    IN p_email VARCHAR(100),
    IN p_password VARCHAR(255),
    IN p_bio TEXT,
    IN p_avatar VARCHAR(255)
)
BEGIN
    INSERT INTO users (username, email, password_hash) 
    VALUES (p_username, p_email, UNHEX(MD5(p_password)));
    
    INSERT INTO profiles (user_id, bio, avatar_url) 
    VALUES (LAST_INSERT_ID(), p_bio, p_avatar);
END //

DELIMITER ;

-- =====================================================================
-- Stored Procedure: User_Follow
-- Manages dynamic follower connections using string usernames
-- =====================================================================
DELIMITER //

CREATE PROCEDURE User_Follow(
    IN p_follower_username VARCHAR(50),
    IN p_following_username VARCHAR(50)
)
BEGIN
    DECLARE v_follower_id INT;
    DECLARE v_following_id INT;
    
    SELECT user_id INTO v_follower_id 
    FROM users 
    WHERE username = p_follower_username;
    
    SELECT user_id INTO v_following_id 
    FROM users 
    WHERE username = p_following_username;
    
    IF v_follower_id IS NOT NULL AND v_following_id IS NOT NULL THEN
        INSERT IGNORE INTO follows (follower_id, following_id) 
        VALUES (v_follower_id, v_following_id);
    END IF;
END //

DELIMITER ;
